# Copy to an ignored local file, fill only the settings you need, then source it.
# Do not commit this file after adding values.

FEISHU_REPORT_ROOT=/path/to/weekly-reports
FEISHU_REPORTS_DIR=/path/to/weekly-reports/2026
FEISHU_SUMMARY_FILE=/path/to/weekly-reports/SUMMARY.md
FEISHU_SOURCE_REPO=/path/to/source-repository
FEISHU_RESEARCH_DIR=research
FEISHU_PAPER_DIR=papers
FEISHU_REPORTS_RELATIVE_DIR=reports

# Required only to pull from Feishu.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_SPACE_ID=
FEISHU_PARENT_NODE_TOKEN=
FEISHU_WEB_BASE_URL=https://feishu.cn

# Required only to upload to Feishu.
FEISHU_UPLOAD_CLI=/path/to/uploader
FEISHU_FOLDER_TOKEN=
FEISHU_PARENT_WIKI_URL=
